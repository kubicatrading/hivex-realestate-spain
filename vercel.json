{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "includeFiles": "{static/**,hivex_local.db}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/pipeline/run",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
