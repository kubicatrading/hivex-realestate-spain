{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{hivex_local.db,app/data/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/pipeline/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/alerts/daily-run",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/v1/health/cockpit-telegram",
      "schedule": "0 8 * * *"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
