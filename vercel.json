{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "hivex_local.db"
    }
  },
  "crons": [
    {
      "path": "/api/v1/pipeline/run",
      "schedule": "*/15 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
